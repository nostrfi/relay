# Node dependencies — reinstalled fresh inside the image
node_modules

# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Git / editor / OS
.git
.idea
.DS_Store

# Env overrides. Patterns are relative to the build context (this directory),
# so they cannot name anything above it — the repository-root .env is already
# outside the context and never reaches the image.
.env
.env.local
