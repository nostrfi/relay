# Example TLS-terminating reverse proxy for the relay and its admin
# dashboard. See README.md's "Deployment" section for how to bring this up
# alongside docker-compose.yml.
#
# `tls internal` makes Caddy issue itself a locally-trusted certificate,
# which is what this file is set up for out of the box (local testing,
# no public domain required). For an internet-facing deployment:
#
#   1. Replace `localhost` below with your real domain.
#   2. Delete the `tls internal` line.
#
# Caddy will then automatically obtain and renew a Let's Encrypt certificate
# via ACME — no other configuration changes are needed.

localhost {
	tls internal

	# Admin dashboard (Nuxt SSR), path-based at /admin. Nuxt's own
	# `app.baseURL: /admin` config expects the /admin prefix on incoming
	# requests, so this uses `handle` (which preserves the path), not
	# `handle_path` (which would strip it).
	handle /admin* {
		reverse_proxy dashboard:3000
	}

	# Everything else (WebSocket upgrades, NIP-11, NIP-86 management,
	# health/readiness) stays on the relay, unchanged.
	handle {
		reverse_proxy relay:8080
	}
}
